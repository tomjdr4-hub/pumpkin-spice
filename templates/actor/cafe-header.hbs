<header class="ps-header ps-cafe-header">
  <img class="ps-portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{actor.name}}">
  <div class="ps-header-main">
    <div class="ps-row">
      <input class="ps-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'PS.Cafe.namePlaceholder'}}">
      {{#if isGM}}
        {{#if isActive}}<span class="ps-badge active"><i class="fa-solid fa-star"></i> {{localize "PS.Cafe.Active"}}</span>
        {{else}}<button type="button" class="ps-badge" data-action="setActive">{{localize "PS.Cafe.SetActive"}}</button>{{/if}}
      {{/if}}
    </div>
    <div class="ps-trackers">
      <div class="ps-tracker ps-vibe">
        <label>{{localize "PS.Cafe.vibe"}} <b>{{system.vibe}}</b>/6</label>
        <div class="ps-vibe-pips">
          {{#each vibePips as |pip|}}{{#if pip.value}}<a class="ps-vibe-pip {{#if pip.on}}on{{/if}}" data-action="setVibe" data-value="{{pip.value}}"><i class="fa-solid fa-heart"></i></a>{{/if}}{{/each}}
        </div>
      </div>
      <div class="ps-tracker ps-magic {{#if fountEmpty}}danger{{/if}}">
        <label>{{localize "PS.Cafe.magic"}}</label>
        <div class="ps-counter">
          <a data-action="adjust" data-field="magic" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
          <input type="number" name="system.magic" value="{{system.magic}}" min="0">
          <a data-action="adjust" data-field="magic" data-delta="1"><i class="fa-solid fa-plus"></i></a>
        </div>
      </div>
      <div class="ps-tracker ps-incident {{#if incidentNow}}danger{{/if}}" data-tooltip="{{localize 'PS.Cafe.incidentHint'}}">
        <label>{{localize "PS.Cafe.incident"}}</label>
        <div class="ps-counter">
          <a data-action="adjust" data-field="incident" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
          <input type="number" name="system.incident" value="{{system.incident}}" min="0">
          <a data-action="adjust" data-field="incident" data-delta="1"><i class="fa-solid fa-plus"></i></a>
        </div>
      </div>
      <div class="ps-tracker ps-day">
        <label>{{localize "PS.Cafe.day"}}</label>
        <div class="ps-counter">
          <a data-action="adjust" data-field="day" data-delta="-1"><i class="fa-solid fa-minus"></i></a>
          <input type="number" name="system.day" value="{{system.day}}" min="1">
          <a data-action="adjust" data-field="day" data-delta="1"><i class="fa-solid fa-plus"></i></a>
        </div>
      </div>
    </div>
    {{#if fountEmpty}}<p class="ps-warn">{{localize "PS.Warn.FountEmpty"}}</p>{{/if}}
    {{#if incidentNow}}<p class="ps-warn">{{localize "PS.Warn.Incident"}}</p>{{/if}}
  </div>
</header>
